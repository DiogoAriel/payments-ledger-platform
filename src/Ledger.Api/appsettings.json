{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "Database": {
    "Provider": "Postgres",
    "AutoMigrate": false
  },
  "ConnectionStrings": {
    "Ledger": "Host=localhost;Port=5432;Database=ledger;Username=ledger;Password=ledger"
  },
  "Messaging": {
    "Kafka": {
      "BootstrapServers": "",
      "Topic": "ledger.events"
    }
  },
  "Auth": {
    "Authority": "",
    "Audience": "payments-ledger-api"
  },
  "Webhooks": {
    "Providers": {}
  },
  "Otel": {
    "ServiceName": "payments-ledger-api"
  },
  "AllowedHosts": "*"
}
