{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft.AspNetCore": "Information"
      }
    }
  },
  "Database": {
    "Provider": "Sqlite",
    "AutoMigrate": true
  },
  "ConnectionStrings": {
    "Ledger": "Data Source=ledger.dev.db"
  },
  "Webhooks": {
    "Providers": {
      "acme-pay": {
        "Secret": "dev-only-secret-change-me",
        "ToleranceSeconds": 300
      }
    }
  }
}
