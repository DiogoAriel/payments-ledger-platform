{
  "permissions": {
    "allow": [
      "Bash(dotnet build:*)",
      "Bash(dotnet test:*)",
      "Bash(dotnet run:*)",
      "Bash(dotnet ef:*)",
      "Bash(dotnet format:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(helm lint:*)",
      "Bash(terraform validate:*)",
      "Bash(terraform fmt:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./**/appsettings.Local.json)",
      "Bash(git push --force:*)",
      "Bash(terraform apply:*)",
      "Bash(terraform destroy:*)"
    ]
  }
}
